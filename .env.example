# ==============================================================================
# SocialPilot AI - Environment Configuration Reference (.env.example)
# DO NOT COMMIT REAL SECRETS, CREDENTIALS, OR PRIVATE TOKENS TO SOURCE CONTROL.
# ==============================================================================

# Server Runtime
NODE_ENV="development"
PORT=3000
APP_URL="https://your-domain.com"

# Master Envelope Encryption Key (32-character / 256-bit key for AES-256-GCM vault)
ENCRYPTION_KEY="replace_with_32_byte_hex_or_cloud_kms_key"

# AI Provider Credentials
# Users configure user-owned Gemini keys in-app (BYO-Key); system fallback only:
GEMINI_API_KEY=""

# Firebase / Google Cloud Project Configuration
# Automatically populated by ProvisionFirebase in firebase-applet-config.json
FIREBASE_PROJECT_ID="citric-shade-s3skh"
FIRESTORE_DATABASE_ID="ai-studio-socialpilotaiais-613b8895-bc8e-4651-aa52-043c4f71b36f"
FIREBASE_STORAGE_BUCKET="citric-shade-s3skh.firebasestorage.app"

# Meta Graph API (Facebook Pages & Instagram Professional)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Telegram Bot API (Channels & Broadcast Groups)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional 3P Social Developer Credentials (OAuth 2.0 PKCE)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
X_API_KEY=""
X_API_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
