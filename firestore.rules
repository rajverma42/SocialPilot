rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. GLOBAL SAFETY NET (Default Deny All)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Check workspace membership via parent doc or member subcollection
    function isWorkspaceMember(wsId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/workspaces/$(wsId)).data.ownerUid == request.auth.uid ||
        exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid))
      );
    }

    function isWorkspaceOwner(wsId) {
      return isSignedIn() && get(/databases/$(database)/documents/workspaces/$(wsId)).data.ownerUid == request.auth.uid;
    }

    // --- 1. USERS COLLECTION ---
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false; // Blanket user listing is strictly forbidden

      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt', 'accountStatus'])
          && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'preferredLanguage', 'timezone', 'onboardingStatus', 'createdAt', 'updatedAt', 'accountStatus'])
          && data.uid == request.auth.uid
          && data.email is string && data.email.size() <= 256
          && data.accountStatus in ['active', 'suspended', 'deactivated'];
      }

      allow create: if isOwner(uid) && isValidId(uid) && isValidUser(incoming());
      allow update: if isOwner(uid) && isValidId(uid) && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'preferredLanguage', 'timezone', 'onboardingStatus', 'updatedAt']);
      allow delete: if false; // User deletion requires server-side cleanup
    }

    // --- 2. WORKSPACES COLLECTION ---
    match /workspaces/{workspaceId} {
      allow get: if isSignedIn() && isValidId(workspaceId) && (existing().ownerUid == request.auth.uid || isWorkspaceMember(workspaceId));
      allow list: if isSignedIn(); // Queries must be scoped to user's workspaces

      function isValidWorkspace(data) {
        return data.keys().hasAll(['workspaceId', 'name', 'ownerUid', 'createdAt', 'updatedAt'])
          && data.workspaceId == workspaceId
          && data.ownerUid == request.auth.uid
          && data.name is string && data.name.size() > 0 && data.name.size() <= 128;
      }

      allow create: if isSignedIn() && isValidId(workspaceId) && isValidWorkspace(incoming());
      allow update: if isWorkspaceOwner(workspaceId) && isValidId(workspaceId) && isValidWorkspace(incoming())
        && incoming().workspaceId == existing().workspaceId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isWorkspaceOwner(workspaceId) && isValidId(workspaceId);

      // 2A. Workspace Members
      match /members/{memberUid} {
        allow get, list: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceOwner(workspaceId) && isValidId(memberUid)
          && incoming().role in ['owner', 'admin', 'editor', 'publisher', 'viewer'];
        allow update: if isWorkspaceOwner(workspaceId) && isValidId(memberUid)
          && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status']);
        allow delete: if isWorkspaceOwner(workspaceId) && isValidId(memberUid) && memberUid != request.auth.uid;
      }

      // 2B. AI Providers (Metadata only; plaintext API keys are NEVER in client Firestore)
      match /aiProviders/{credentialId} {
        allow get, list: if isWorkspaceMember(workspaceId);
        allow create, update: if isWorkspaceMember(workspaceId) && isValidId(credentialId)
          && incoming().provider in ['gemini', 'openai', 'anthropic']
          && incoming().selectedModel is string && incoming().selectedModel.size() <= 64;
        allow delete: if isWorkspaceMember(workspaceId) && isValidId(credentialId);
      }

      // 2C. Social Accounts (Destinations)
      match /socialAccounts/{socialAccountId} {
        allow get, list: if isWorkspaceMember(workspaceId);
        allow create, update: if isWorkspaceMember(workspaceId) && isValidId(socialAccountId)
          && incoming().accountName is string && incoming().accountName.size() <= 128;
        allow delete: if isWorkspaceMember(workspaceId) && isValidId(socialAccountId);
      }

      // 2D. Posts
      match /posts/{postId} {
        allow get, list: if isWorkspaceMember(workspaceId);

        function isValidPost(data) {
          return data.keys().hasAll(['postId', 'workspaceId', 'topic', 'status', 'createdAt', 'updatedAt'])
            && data.postId == postId
            && data.workspaceId == workspaceId
            && data.topic is string && data.topic.size() <= 512
            && data.status in ['draft', 'awaiting_approval', 'scheduled', 'queued', 'publishing', 'published', 'failed', 'cancelled'];
        }

        allow create: if isWorkspaceMember(workspaceId) && isValidId(postId) && isValidPost(incoming());
        allow update: if isWorkspaceMember(workspaceId) && isValidId(postId) && isValidPost(incoming())
          && incoming().postId == existing().postId
          && incoming().createdAt == existing().createdAt
          // Client cannot directly set status to 'published' (only server publishing engine can)
          && (incoming().status != 'published' || existing().status == 'published');
        allow delete: if isWorkspaceMember(workspaceId) && isValidId(postId);

        // Sub-collection: Post Destinations
        match /destinations/{destinationId} {
          allow get, list: if isWorkspaceMember(workspaceId);
          allow create, update: if isWorkspaceMember(workspaceId) && isValidId(destinationId)
            // Client cannot fake 'published' status
            && (incoming().status != 'published' || existing().status == 'published');
          allow delete: if isWorkspaceMember(workspaceId) && isValidId(destinationId);
        }
      }

      // 2E. Notifications
      match /notifications/{notificationId} {
        allow get, list: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId) && isValidId(notificationId);
        allow update: if isWorkspaceMember(workspaceId) && isValidId(notificationId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['readAt']);
        allow delete: if isWorkspaceMember(workspaceId) && isValidId(notificationId);
      }

      // 2F. Media Assets
      match /mediaAssets/{mediaId} {
        allow get, list: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId) && isValidId(mediaId);
        allow update: if isWorkspaceMember(workspaceId) && isValidId(mediaId);
        allow delete: if isWorkspaceMember(workspaceId) && isValidId(mediaId);
      }

      // 2G. Automation Rules
      match /automationRules/{automationId} {
        allow get, list: if isWorkspaceMember(workspaceId);
        allow create, update: if isWorkspaceMember(workspaceId) && isValidId(automationId)
          && incoming().status in ['active', 'paused', 'stopped'];
        allow delete: if isWorkspaceMember(workspaceId) && isValidId(automationId);
      }

      // 2H. Content Sources (RSS / Websites)
      match /contentSources/{sourceId} {
        allow get, list: if isWorkspaceMember(workspaceId);
        allow create, update: if isWorkspaceMember(workspaceId) && isValidId(sourceId);
        allow delete: if isWorkspaceMember(workspaceId) && isValidId(sourceId);
      }
    }

    // --- 3. AUDIT LOGS (Immutable, Append-Only by System) ---
    match /auditLogs/{auditLogId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(auditLogId);
      allow update, delete: if false; // Strict immutability
    }

  }
}
